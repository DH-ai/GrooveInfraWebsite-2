# =============================================================================
# Copy to .env.local and fill in. Never commit .env.local.
# =============================================================================


# =============================================================================
# SUPABASE — project data and image storage
# =============================================================================
# Both NEXT_PUBLIC_* values are exposed to the browser by design.
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key

# Server-only. Bypasses Row Level Security, so it must never be prefixed
# NEXT_PUBLIC_ or referenced from a client component. Used for admin writes and
# for signing storage upload URLs.
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key


# =============================================================================
# ADMIN PANEL
# =============================================================================
ADMIN_USERNAME=admin
ADMIN_PASSWORD=your-secure-password

# HMAC key used to sign the admin session cookie. Use a long random value, e.g.
#   openssl rand -hex 32
# ADMIN_TOKEN is still read as a fallback so existing deployments keep working,
# but new setups should set ADMIN_SESSION_SECRET.
ADMIN_SESSION_SECRET=generate-a-long-random-value
# ADMIN_TOKEN=legacy-fallback-for-ADMIN_SESSION_SECRET


# =============================================================================
# SPAM PROTECTION — Cloudflare Turnstile (optional)
# =============================================================================
# Leave both unset and the CAPTCHA is skipped: the widget does not render and the
# server does not verify, so the form keeps working. The honeypot, timing check
# and rate limiter apply either way. Set both to switch the CAPTCHA on.
# Create a widget at https://dash.cloudflare.com -> Turnstile
# NEXT_PUBLIC_TURNSTILE_SITE_KEY=0x4AAAAAAA...
# TURNSTILE_SECRET_KEY=0x4AAAAAAA...


# =============================================================================
# EMAIL — Resend
# =============================================================================
RESEND_API_KEY=re_xxxxxxxxxxxx

# Public-facing @grooveinfra.in addresses. Use the real values in .env.local.
#   PUBLIC_CONTACT_EMAIL  the address shown on the site
#   NOREPLY_FROM          sends the confirmation to the visitor
#   ENQUIRY_FROM          sends the enquiry alert to you
PUBLIC_CONTACT_EMAIL=contact@example.com
NOREPLY_FROM=noreply@example.com
ENQUIRY_FROM=enquire@example.com

# Private — set in .env.local only, never commit a real address.
# Where enquiry alerts are delivered.
# ENQUIRY_INBOX=your-personal@gmail.com

# Optional: npm run email:test (defaults to ENQUIRY_INBOX)
# TEST_EMAIL_TO=your-personal@gmail.com
